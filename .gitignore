node_modules/
dist/
.next/
build/
*.env
.turbo/
.DS_Store
*.tsbuildinfo
prisma/migrations/

# Compiled output from ts-node / tsc (not the NestJS dist/)
backend/prisma/*.js
backend/prisma/*.js.map
backend/prisma/*.d.ts
packages/shared-types/src/*.js
packages/shared-types/src/*.js.map
packages/shared-types/src/*.d.ts

# Auto-generated by NestJS's GraphQLModule on every app boot (local dev only —
# Vercel keeps it in-memory). No codegen or CI reads the checked-in file, so
# tracking it was pure diff noise.
backend/src/schema.gql

# Local env overrides (hold real keys)
.env.local
.env*.local

# Example env files (.env.example, .env.local.example) are not tracked either
.env.example
.env*.example

# Output of backend/scripts/compare-proof-models.ts (may contain names read from documents)
proof-model-comparison-*.json
backend/sample-proofs/
backend/email-previews/

# Pose-model weights are downloaded, not committed (AGPL — see backend/models/README.md)
backend/models/*.onnx
backend/models/*.pt

# Proof-reader test documents: the synthetic set is regenerated on demand (pnpm make-proof-test-set); anything in
# private/ may be a real prescription and must never be committed.
backend/eval/proof-reader/synthetic/
backend/eval/proof-reader/private/
backend/proof-model-comparison-*.json
