generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLINICIAN
  PATIENT
  ADMIN
}

enum ConsultationStatus {
  SUBMITTED
  IN_REVIEW
  APPROVED
  DECLINED
  MORE_INFO_REQUESTED
}

enum ConsultationKind {
  HRT
  GLP1
}

enum RedFlagSeverity {
  CRITICAL
  WARNING
}

enum ClinicianRole {
  ADMIN
  DOCTOR
  CX_TEAM
  PROVIDER
}

model Clinician {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String        @map("password_hash")
  firstName    String        @map("first_name")
  lastName     String        @map("last_name")
  gmcNumber    String?       @unique @map("gmc_number")
  role         ClinicianRole @default(DOCTOR)
  isVerified   Boolean       @default(false) @map("is_verified")
  mfaSecret    String?       @map("mfa_secret")
  mfaEnabled   Boolean       @default(false) @map("mfa_enabled")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  consultations Consultation[]

  @@map("clinicians")
}

model Lead {
  id              String           @id @default(cuid())
  email           String           @unique
  firstName       String           @map("first_name")
  lastName        String           @map("last_name")
  productKind     ConsultationKind @map("product_kind")
  quizAnswers     Json             @map("quiz_answers")
  stripeSessionId String?          @map("stripe_session_id")
  convertedAt     DateTime?        @map("converted_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  patient Patient?

  @@map("leads")
}

model Patient {
  id                      String    @id @default(cuid())
  email                   String    @unique
  passwordHash            String    @map("password_hash")
  firstName               String    @map("first_name")
  lastName                String    @map("last_name")
  dateOfBirth             DateTime  @map("date_of_birth")
  leadId                  String?   @unique @map("lead_id")
  activationToken         String?   @unique @map("activation_token")
  activationTokenExpiresAt DateTime? @map("activation_token_expires_at")
  activatedAt             DateTime? @map("activated_at")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  lead          Lead?          @relation(fields: [leadId], references: [id])
  consultations Consultation[]

  @@map("patients")
}

model Consultation {
  id          String             @id @default(cuid())
  patientId   String             @map("patient_id")
  clinicianId String?            @map("clinician_id")
  kind        ConsultationKind
  status      ConsultationStatus @default(SUBMITTED)
  quizAnswers Json               @map("quiz_answers")
  submittedAt DateTime           @default(now()) @map("submitted_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  patient      Patient       @relation(fields: [patientId], references: [id])
  clinician    Clinician?    @relation(fields: [clinicianId], references: [id])
  redFlags     RedFlag[]
  prescription Prescription?
  messages     Message[]

  @@map("consultations")
}

model RedFlag {
  id             String          @id @default(cuid())
  consultationId String          @map("consultation_id")
  description    String
  severity       RedFlagSeverity
  createdAt      DateTime        @default(now()) @map("created_at")

  consultation Consultation @relation(fields: [consultationId], references: [id])

  @@map("red_flags")
}

model Prescription {
  id             String    @id @default(cuid())
  consultationId String    @unique @map("consultation_id")
  medication     String
  dosage         String
  instructions   String
  issuedAt       DateTime  @default(now()) @map("issued_at")
  pharmacyRef    String?   @map("pharmacy_ref")
  dispatchedAt   DateTime? @map("dispatched_at")

  consultation Consultation @relation(fields: [consultationId], references: [id])

  @@map("prescriptions")
}

model Message {
  id             String   @id @default(cuid())
  consultationId String   @map("consultation_id")
  senderId       String   @map("sender_id")
  senderRole     Role     @map("sender_role")
  content        String
  sentAt         DateTime @default(now()) @map("sent_at")

  consultation Consultation @relation(fields: [consultationId], references: [id])

  @@map("messages")
}

// Append-only — enforce INSERT/SELECT only grants at DB level, not just here
model AuditLogEntry {
  id           String   @id @default(cuid())
  actorId      String   @map("actor_id")
  actorRole    Role     @map("actor_role")
  action       String
  resourceType String   @map("resource_type")
  resourceId   String   @map("resource_id")
  metadata     Json?
  timestamp    DateTime @default(now())

  @@map("audit_log_entries")
}
