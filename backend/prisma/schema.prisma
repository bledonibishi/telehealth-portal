generator client {
  provider      = "prisma-client-js"
  // "native" for local dev; rhel-openssl-3.0.x is what Vercel's serverless
  // functions run on — without it Prisma can't find a matching query engine
  // binary at runtime, even though the build itself succeeds.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLINICIAN
  PATIENT
  ADMIN
}

enum ConsultationStatus {
  SUBMITTED
  IN_REVIEW
  APPROVED
  DECLINED
  MORE_INFO_REQUESTED
}

enum ConsultationKind {
  HRT
  GLP1
}

enum RedFlagSeverity {
  CRITICAL
  WARNING
}

enum ClinicianRole {
  ADMIN
  DOCTOR
  CX_TEAM
  PROVIDER
}

enum CheckInStatus {
  SCHEDULED
  SENT
  COMPLETED
}

enum UploadKind {
  ID_DOCUMENT
  SELFIE
  BODY_PHOTO_FRONT
  BODY_PHOTO_SIDE
  PRESCRIPTION_PROOF
}

enum OnboardingStatus {
  IN_PROGRESS
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum PersonaStatus {
  NOT_STARTED
  PENDING
  VERIFIED
  FAILED
  NOT_CONFIGURED
}

enum PhotoReviewStatus {
  NOT_STARTED
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum RefundStatus {
  NOT_REQUIRED
  REFUNDED
  FAILED
}

enum ProductCategory {
  GLP1
  ESTROGEN
  PROGESTOGEN
}

enum ProductForm {
  INJECTION_PEN
  GEL
  PATCH
  TABLET
  CAPSULE
  SPRAY
}

enum PrescriptionStatus {
  ACTIVE
  SUPERSEDED
  CANCELLED
}

enum OrderStatus {
  PENDING
  DISPATCHED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum CheckInOutcome {
  REPEAT
  NEW_PRESCRIPTION
  HOLD
  STOP
}

enum ConsentType {
  TELEHEALTH
}

enum PrescriptionProofType {
  MEDICINE_BOX_LABEL
  PRESCRIPTION_DOCUMENT
  PHARMACY_RECORD
  ORDER_CONFIRMATION
}

model Clinician {
  id            String        @id @default(cuid())
  email         String        @unique
  passwordHash  String        @map("password_hash")
  firstName     String        @map("first_name")
  lastName      String        @map("last_name")
  // Medical licence — required (with isVerified) before a clinician can prescribe
  licenseNumber String?       @unique @map("license_number")
  licensingBody String?       @map("licensing_body")
  role          ClinicianRole @default(DOCTOR)
  isVerified    Boolean       @default(false) @map("is_verified")
  verifiedAt    DateTime?     @map("verified_at")
  verifiedById  String?       @map("verified_by_id")
  mfaSecret     String?       @map("mfa_secret")
  mfaEnabled    Boolean       @default(false) @map("mfa_enabled")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  consultations       Consultation[]
  reviewedOnboardings OnboardingSubmission[]
  prescriptions       Prescription[]
  reviewedCheckIns    CheckIn[]

  @@map("clinicians")
}

model Lead {
  id              String           @id @default(cuid())
  email           String           @unique
  firstName       String           @map("first_name")
  lastName        String           @map("last_name")
  productKind     ConsultationKind @map("product_kind")
  quizAnswers     Json             @map("quiz_answers")
  stripeSessionId String?          @map("stripe_session_id")
  convertedAt     DateTime?        @map("converted_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  patient Patient?

  @@map("leads")
}

model Patient {
  id                       String    @id @default(cuid())
  email                    String    @unique
  passwordHash             String    @map("password_hash")
  firstName                String    @map("first_name")
  lastName                 String    @map("last_name")
  dateOfBirth              DateTime  @map("date_of_birth")
  leadId                   String?   @unique @map("lead_id")
  activationToken          String?   @unique @map("activation_token")
  activationTokenExpiresAt DateTime? @map("activation_token_expires_at")
  activatedAt              DateTime? @map("activated_at")
  stripeCustomerId         String?   @map("stripe_customer_id")
  stripeSubscriptionId     String?   @map("stripe_subscription_id")
  phone                    String?   @map("phone")
  addressLine1             String?   @map("address_line1")
  addressLine2             String?   @map("address_line2")
  city                     String?   @map("city")
  postcode                 String?   @map("postcode")
  country                  String?   @map("country")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  lead          Lead?                 @relation(fields: [leadId], references: [id])
  consultations Consultation[]
  uploadedFiles UploadedFile[]
  onboarding    OnboardingSubmission?
  checkIns      CheckIn[]
  prescriptions Prescription[]
  orders        Order[]
  consents      Consent[]

  @@map("patients")
}

model Consultation {
  id                   String             @id @default(cuid())
  patientId            String             @map("patient_id")
  clinicianId          String?            @map("clinician_id")
  kind                 ConsultationKind
  status               ConsultationStatus @default(SUBMITTED)
  quizAnswers          Json               @map("quiz_answers")
  // Which questionnaire wording the answers were given against, e.g. "GLP1-intake@1".
  questionnaireVersion String?            @map("questionnaire_version")
  declineReason        String?            @map("decline_reason")
  refundStatus         RefundStatus?      @map("refund_status")
  submittedAt          DateTime           @default(now()) @map("submitted_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  patient      Patient       @relation(fields: [patientId], references: [id])
  clinician    Clinician?    @relation(fields: [clinicianId], references: [id])
  redFlags     RedFlag[]
  prescription Prescription?
  messages     Message[]

  @@map("consultations")
}

model RedFlag {
  id             String          @id @default(cuid())
  consultationId String          @map("consultation_id")
  description    String
  severity       RedFlagSeverity
  createdAt      DateTime        @default(now()) @map("created_at")

  consultation Consultation @relation(fields: [consultationId], references: [id])

  @@map("red_flags")
}

model Prescription {
  id             String             @id @default(cuid())
  // The consultation that led to the first prescription. Later dose changes
  // (from check-ins) are new prescriptions with no consultation, linked back
  // through supersedesId.
  consultationId String?            @unique @map("consultation_id")
  patientId      String             @map("patient_id")
  prescriberId   String?            @map("prescriber_id")
  status         PrescriptionStatus @default(ACTIVE)
  // Human-readable summaries of `items`, kept for the order and patient views.
  medication     String
  dosage         String
  instructions   String
  validUntil     DateTime?          @map("valid_until")
  refillsAllowed Int                @default(0) @map("refills_allowed")
  // Why the prescriber went against a prescribing rule, when they did.
  overrideReason String?            @map("override_reason")
  // SHA-256 of the prescription's canonical content at issue — printed on the
  // document so a pharmacy can detect alteration.
  contentHash    String?            @map("content_hash")
  supersedesId   String?            @unique @map("supersedes_id")
  cancelledAt    DateTime?          @map("cancelled_at")
  cancelReason   String?            @map("cancel_reason")
  issuedAt       DateTime           @default(now()) @map("issued_at")

  consultation Consultation?      @relation(fields: [consultationId], references: [id])
  patient      Patient            @relation(fields: [patientId], references: [id])
  prescriber   Clinician?         @relation(fields: [prescriberId], references: [id])
  supersedes   Prescription?      @relation("PrescriptionHistory", fields: [supersedesId], references: [id])
  supersededBy Prescription?      @relation("PrescriptionHistory")
  items        PrescriptionItem[]
  orders       Order[]
  checkIns     CheckIn[]          @relation("CheckInPrescription")

  @@index([patientId])
  @@map("prescriptions")
}

// One supply of a prescription: the first fill, then one per repeat. What the
// pharmacy dispatches and the patient tracks.
model Order {
  id               String      @id @default(cuid())
  prescriptionId   String      @map("prescription_id")
  patientId        String      @map("patient_id")
  // 1 = first supply; each repeat increments.
  sequence         Int
  status           OrderStatus @default(PENDING)
  // Snapshot at dispatch, so later address changes don't rewrite history.
  shippingAddress  Json?       @map("shipping_address")
  pharmacyRef      String?     @map("pharmacy_ref")
  dispatchedAt     DateTime?   @map("dispatched_at")
  carrier          String?
  trackingNumber   String?     @map("tracking_number")
  trackingUrl      String?     @map("tracking_url")
  outForDeliveryAt DateTime?   @map("out_for_delivery_at")
  deliveredAt      DateTime?   @map("delivered_at")
  cancelledAt      DateTime?   @map("cancelled_at")
  cancelReason     String?     @map("cancel_reason")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  prescription Prescription @relation(fields: [prescriptionId], references: [id])
  patient      Patient      @relation(fields: [patientId], references: [id])

  @@unique([prescriptionId, sequence])
  @@index([status])
  @@map("orders")
}

model PrescriptionItem {
  id             String @id @default(cuid())
  prescriptionId String @map("prescription_id")
  productId      String @map("product_id")
  strengthId     String @map("strength_id")
  quantity       Int
  directions     String

  prescription Prescription    @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  product      Product         @relation(fields: [productId], references: [id])
  strength     ProductStrength @relation(fields: [strengthId], references: [id])

  @@map("prescription_items")
}

// Medicines a clinician can prescribe. Seeded; review with the partner
// pharmacy before go-live.
model Product {
  id                String           @id @default(cuid())
  slug              String           @unique
  name              String
  brandName         String?          @map("brand_name")
  kind              ConsultationKind
  category          ProductCategory
  form              ProductForm
  requiresColdChain Boolean          @default(false) @map("requires_cold_chain")
  // Minimum weeks on a titration step before stepping up.
  weeksPerStep      Int?             @map("weeks_per_step")
  defaultDirections String?          @map("default_directions")
  active            Boolean          @default(true)
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  strengths         ProductStrength[]
  prescriptionItems PrescriptionItem[]

  @@map("products")
}

model ProductStrength {
  id              String  @id @default(cuid())
  productId       String  @map("product_id")
  label           String
  packDescription String? @map("pack_description")
  // 1 = starting dose. Null for products that aren't titrated.
  titrationStep   Int?    @map("titration_step")
  defaultQuantity Int     @default(1) @map("default_quantity")
  sortOrder       Int     @default(0) @map("sort_order")
  active          Boolean @default(true)

  product           Product            @relation(fields: [productId], references: [id])
  prescriptionItems PrescriptionItem[]

  @@unique([productId, label])
  @@map("product_strengths")
}

model Message {
  id             String   @id @default(cuid())
  consultationId String   @map("consultation_id")
  senderId       String   @map("sender_id")
  senderRole     Role     @map("sender_role")
  content        String
  sentAt         DateTime @default(now()) @map("sent_at")

  consultation Consultation @relation(fields: [consultationId], references: [id])

  @@map("messages")
}

// Append-only — enforce INSERT/SELECT only grants at DB level, not just here
model AuditLogEntry {
  id           String   @id @default(cuid())
  actorId      String   @map("actor_id")
  actorRole    Role     @map("actor_role")
  action       String
  resourceType String   @map("resource_type")
  resourceId   String   @map("resource_id")
  metadata     Json?
  timestamp    DateTime @default(now())

  @@map("audit_log_entries")
}

model UploadedFile {
  id         String     @id @default(cuid())
  patientId  String     @map("patient_id")
  kind       UploadKind
  filename   String
  mimeType   String     @map("mime_type")
  storageKey String     @map("storage_key")
  createdAt  DateTime   @default(now()) @map("created_at")

  patient Patient @relation(fields: [patientId], references: [id])

  @@map("uploaded_files")
}

model CheckIn {
  id                   String            @id @default(cuid())
  patientId            String            @map("patient_id")
  dueAt                DateTime          @map("due_at")
  status               CheckInStatus     @default(SCHEDULED)
  token                String?           @unique
  tokenExpiresAt       DateTime?         @map("token_expires_at")
  sentAt               DateTime?         @map("sent_at")
  answers              Json?
  wantsToReorder       Boolean?          @map("wants_to_reorder")
  // Captured on submission: the programme, questionnaire wording, the flags the
  // answers raised, and the prescription the patient was on at the time.
  kind                 ConsultationKind? @map("kind")
  questionnaireVersion String?           @map("questionnaire_version")
  redFlags             Json              @default("[]") @map("red_flags")
  prescriptionId       String?           @map("prescription_id")
  // The doctor's review of the completed check-in.
  reviewedAt           DateTime?         @map("reviewed_at")
  reviewedById         String?           @map("reviewed_by_id")
  outcome              CheckInOutcome?
  reviewNote           String?           @map("review_note")
  // What happened to billing as a result (price change, pause, cancellation).
  billingNote          String?           @map("billing_note")
  resultOrderId        String?           @map("result_order_id")
  resultPrescriptionId String?           @map("result_prescription_id")
  completedAt          DateTime?         @map("completed_at")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  patient      Patient       @relation(fields: [patientId], references: [id])
  prescription Prescription? @relation("CheckInPrescription", fields: [prescriptionId], references: [id])
  reviewedBy   Clinician?    @relation(fields: [reviewedById], references: [id])

  @@map("check_ins")
}

model OnboardingSubmission {
  id                      String                 @id @default(cuid())
  patientId               String                 @unique @map("patient_id")
  idDocumentFileId        String?                @map("id_document_file_id")
  selfieFileId            String?                @map("selfie_file_id")
  personaStatus           PersonaStatus          @default(NOT_STARTED) @map("persona_status")
  bodyPhotoFrontFileId    String?                @map("body_photo_front_file_id")
  bodyPhotoSideFileId     String?                @map("body_photo_side_file_id")
  photoReviewStatus       PhotoReviewStatus      @default(NOT_STARTED) @map("photo_review_status")
  priorMedicationUse      Boolean?               @map("prior_medication_use")
  prescriptionProofType   PrescriptionProofType? @map("prescription_proof_type")
  prescriptionProofFileId String?                @map("prescription_proof_file_id")
  status                  OnboardingStatus       @default(IN_PROGRESS) @map("status")
  submittedAt             DateTime?              @map("submitted_at")
  reviewedAt              DateTime?              @map("reviewed_at")
  reviewedByClinicianId   String?                @map("reviewed_by_clinician_id")
  stepFeedback            Json                   @default("[]") @map("step_feedback")
  createdAt               DateTime               @default(now()) @map("created_at")
  updatedAt               DateTime               @updatedAt @map("updated_at")

  patient             Patient    @relation(fields: [patientId], references: [id])
  reviewedByClinician Clinician? @relation(fields: [reviewedByClinicianId], references: [id])

  @@map("onboarding_submissions")
}

// A patient agreeing to a specific version of a consent text. Append-only
// (enforced by a trigger), like the audit log: withdrawing consent is a new
// record, not an edit.
model Consent {
  id         String      @id @default(cuid())
  patientId  String      @map("patient_id")
  type       ConsentType
  version    String
  acceptedAt DateTime    @default(now()) @map("accepted_at")
  ipAddress  String?     @map("ip_address")
  userAgent  String?     @map("user_agent")

  patient Patient @relation(fields: [patientId], references: [id])

  @@index([patientId, type])
  @@map("consents")
}
