generator client {
  provider      = "prisma-client-js"
  // "native" for local dev; rhel-openssl-3.0.x is what Vercel's serverless
  // functions run on — without it Prisma can't find a matching query engine
  // binary at runtime, even though the build itself succeeds.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLINICIAN
  PATIENT
  ADMIN
}

enum ConsultationStatus {
  SUBMITTED
  IN_REVIEW
  APPROVED
  DECLINED
  MORE_INFO_REQUESTED
}

enum ConsultationKind {
  HRT
  GLP1
  TRT
}

enum RedFlagSeverity {
  CRITICAL
  WARNING
}

enum ClinicianRole {
  ADMIN
  DOCTOR
  CX_TEAM
  PROVIDER
}

enum CheckInStatus {
  SCHEDULED
  SENT
  COMPLETED
}

enum CheckInFeeling {
  GREAT
  GOOD
  OKAY
  DIFFICULTIES
  NOT_WELL
}

enum WeightEntrySource {
  PATIENT
  STAFF
}

enum UploadKind {
  ID_DOCUMENT
  SELFIE
  BODY_PHOTO_FRONT
  BODY_PHOTO_SIDE
  PRESCRIPTION_PROOF
}

enum OnboardingStatus {
  IN_PROGRESS
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum PersonaStatus {
  NOT_STARTED
  PENDING
  VERIFIED
  FAILED
  NOT_CONFIGURED
}

// Mirrors the statuses verify-service reports for an identity-check session.
enum IdentityVerificationStatus {
  PENDING
  PROCESSING
  NEEDS_REVIEW
  APPROVED
  REJECTED
  EXPIRED
}

enum PhotoReviewStatus {
  NOT_STARTED
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum RefundStatus {
  NOT_REQUIRED
  REFUNDED
  FAILED
}

enum ProductCategory {
  GLP1
  ESTROGEN
  PROGESTOGEN
  TESTOSTERONE
}

enum ProductForm {
  INJECTION_PEN
  INJECTION_VIAL
  GEL
  PATCH
  TABLET
  CAPSULE
  SPRAY
  PELLET
}

enum PrescriptionStatus {
  ACTIVE
  SUPERSEDED
  CANCELLED
}

enum OrderStatus {
  PENDING
  DISPATCHED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum CheckInOutcome {
  REPEAT
  NEW_PRESCRIPTION
  HOLD
  STOP
}

enum ConsentType {
  TELEHEALTH
}

enum PrescriptionProofType {
  MEDICINE_BOX_LABEL
  PRESCRIPTION_DOCUMENT
  PHARMACY_RECORD
  ORDER_CONFIRMATION
}

enum ReferralStatus {
  PENDING
  CONVERTED
}

enum VoucherKind {
  REFERRER_REWARD
  REFEREE_REWARD
}

enum VoucherStatus {
  ISSUED
  APPLIED
}

enum LabResultKind {
  ESTRADIOL
  TESTOSTERONE
  FSH
  LH
  SHBG
  PSA
  HEMATOCRIT
  LIPID_PANEL
  HBA1C
  LIVER_FUNCTION
  OTHER
}

model Clinician {
  id            String        @id @default(cuid())
  email         String        @unique
  passwordHash  String        @map("password_hash")
  firstName     String        @map("first_name")
  lastName      String        @map("last_name")
  // Medical licence — required (with isVerified) before a clinician can prescribe
  licenseNumber String?       @unique @map("license_number")
  licensingBody String?       @map("licensing_body")
  role          ClinicianRole @default(DOCTOR)
  isVerified    Boolean       @default(false) @map("is_verified")
  verifiedAt    DateTime?     @map("verified_at")
  verifiedById  String?       @map("verified_by_id")
  mfaSecret     String?       @map("mfa_secret")
  mfaEnabled    Boolean       @default(false) @map("mfa_enabled")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  consultations       Consultation[]
  reviewedOnboardings OnboardingSubmission[]
  prescriptions       Prescription[]
  reviewedCheckIns    CheckIn[]
  enteredLabResults   LabResult[]            @relation("LabResultEnteredBy")
  reviewedLabResults  LabResult[]            @relation("LabResultReviewedBy")

  @@map("clinicians")
}

model Lead {
  id              String           @id @default(cuid())
  email           String           @unique
  firstName       String           @map("first_name")
  lastName        String           @map("last_name")
  productKind     ConsultationKind @map("product_kind")
  quizAnswers     Json             @map("quiz_answers")
  stripeSessionId String?          @map("stripe_session_id")
  // The referrer's code this lead arrived with, if any — kept even before a
  // Referral row exists, since LeadsService validates it at creation time.
  referralCode    String?          @map("referral_code")
  // Delivery details and whether the referral reward was applied, captured at
  // checkout and copied onto the Patient when the first payment succeeds.
  checkoutDetails Json?            @map("checkout_details")
  convertedAt     DateTime?        @map("converted_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  patient  Patient?
  referral Referral?

  @@map("leads")
}

model Patient {
  id                       String    @id @default(cuid())
  email                    String    @unique
  passwordHash             String    @map("password_hash")
  firstName                String    @map("first_name")
  lastName                 String    @map("last_name")
  dateOfBirth              DateTime  @map("date_of_birth")
  leadId                   String?   @unique @map("lead_id")
  activationToken          String?   @unique @map("activation_token")
  activationTokenExpiresAt DateTime? @map("activation_token_expires_at")
  activatedAt              DateTime? @map("activated_at")
  stripeCustomerId         String?   @map("stripe_customer_id")
  stripeSubscriptionId     String?   @map("stripe_subscription_id")
  // This patient's own shareable referral code — generated lazily on first use.
  referralCode             String?   @unique @map("referral_code")
  // Whether a reward this patient earns is credited automatically, or left for
  // them to apply themselves from the Rewards page. Defaults to today's
  // auto-apply behaviour.
  voucherAutoApply         Boolean   @default(true) @map("voucher_auto_apply")
  phone                    String?   @map("phone")
  addressLine1             String?   @map("address_line1")
  addressLine2             String?   @map("address_line2")
  city                     String?   @map("city")
  postcode                 String?   @map("postcode")
  country                  String?   @map("country")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  lead                  Lead?                  @relation(fields: [leadId], references: [id])
  consultations         Consultation[]
  uploadedFiles         UploadedFile[]
  onboarding            OnboardingSubmission?
  checkIns              CheckIn[]
  prescriptions         Prescription[]
  orders                Order[]
  consents              Consent[]
  weightGoal            WeightGoal?
  weightEntries         WeightEntry[]
  doseEvents            DoseEvent[]
  symptomAssessments    SymptomAssessment[]
  labResults            LabResult[]
  referralsMade         Referral[]             @relation("ReferralsMade")
  referralsReceived     Referral?              @relation("ReferralsReceived")
  vouchers              Voucher[]
  identityVerifications IdentityVerification[]

  @@map("patients")
}

model Consultation {
  id                   String             @id @default(cuid())
  patientId            String             @map("patient_id")
  clinicianId          String?            @map("clinician_id")
  kind                 ConsultationKind
  status               ConsultationStatus @default(SUBMITTED)
  quizAnswers          Json               @map("quiz_answers")
  // Which questionnaire wording the answers were given against, e.g. "GLP1-intake@1".
  questionnaireVersion String?            @map("questionnaire_version")
  declineReason        String?            @map("decline_reason")
  refundStatus         RefundStatus?      @map("refund_status")
  submittedAt          DateTime           @default(now()) @map("submitted_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  patient      Patient       @relation(fields: [patientId], references: [id])
  clinician    Clinician?    @relation(fields: [clinicianId], references: [id])
  redFlags     RedFlag[]
  prescription Prescription?
  messages     Message[]

  @@map("consultations")
}

model RedFlag {
  id             String          @id @default(cuid())
  consultationId String          @map("consultation_id")
  description    String
  severity       RedFlagSeverity
  createdAt      DateTime        @default(now()) @map("created_at")

  consultation Consultation @relation(fields: [consultationId], references: [id])

  @@map("red_flags")
}

model Prescription {
  id             String             @id @default(cuid())
  // The consultation that led to the first prescription. Later dose changes
  // (from check-ins) are new prescriptions with no consultation, linked back
  // through supersedesId.
  consultationId String?            @unique @map("consultation_id")
  patientId      String             @map("patient_id")
  prescriberId   String?            @map("prescriber_id")
  status         PrescriptionStatus @default(ACTIVE)
  // Human-readable summaries of `items`, kept for the order and patient views.
  medication     String
  dosage         String
  instructions   String
  validUntil     DateTime?          @map("valid_until")
  refillsAllowed Int                @default(0) @map("refills_allowed")
  // Why the prescriber went against a prescribing rule, when they did.
  overrideReason String?            @map("override_reason")
  // SHA-256 of the prescription's canonical content at issue — printed on the
  // document so a pharmacy can detect alteration.
  contentHash    String?            @map("content_hash")
  supersedesId   String?            @unique @map("supersedes_id")
  cancelledAt    DateTime?          @map("cancelled_at")
  cancelReason   String?            @map("cancel_reason")
  issuedAt       DateTime           @default(now()) @map("issued_at")

  consultation Consultation?      @relation(fields: [consultationId], references: [id])
  patient      Patient            @relation(fields: [patientId], references: [id])
  prescriber   Clinician?         @relation(fields: [prescriberId], references: [id])
  supersedes   Prescription?      @relation("PrescriptionHistory", fields: [supersedesId], references: [id])
  supersededBy Prescription?      @relation("PrescriptionHistory")
  items        PrescriptionItem[]
  orders       Order[]
  checkIns     CheckIn[]          @relation("CheckInPrescription")

  @@index([patientId])
  @@map("prescriptions")
}

// One supply of a prescription: the first fill, then one per repeat. What the
// pharmacy dispatches and the patient tracks.
model Order {
  id               String      @id @default(cuid())
  prescriptionId   String      @map("prescription_id")
  patientId        String      @map("patient_id")
  // 1 = first supply; each repeat increments.
  sequence         Int
  status           OrderStatus @default(PENDING)
  // Snapshot at dispatch, so later address changes don't rewrite history.
  shippingAddress  Json?       @map("shipping_address")
  pharmacyRef      String?     @map("pharmacy_ref")
  dispatchedAt     DateTime?   @map("dispatched_at")
  carrier          String?
  trackingNumber   String?     @map("tracking_number")
  trackingUrl      String?     @map("tracking_url")
  outForDeliveryAt DateTime?   @map("out_for_delivery_at")
  deliveredAt      DateTime?   @map("delivered_at")
  cancelledAt      DateTime?   @map("cancelled_at")
  cancelReason     String?     @map("cancel_reason")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  prescription Prescription @relation(fields: [prescriptionId], references: [id])
  patient      Patient      @relation(fields: [patientId], references: [id])

  @@unique([prescriptionId, sequence])
  @@index([status])
  @@map("orders")
}

model PrescriptionItem {
  id             String @id @default(cuid())
  prescriptionId String @map("prescription_id")
  productId      String @map("product_id")
  strengthId     String @map("strength_id")
  quantity       Int
  directions     String

  prescription Prescription    @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  product      Product         @relation(fields: [productId], references: [id])
  strength     ProductStrength @relation(fields: [strengthId], references: [id])
  doseEvents   DoseEvent[]

  @@map("prescription_items")
}

// Medicines a clinician can prescribe. Seeded; review with the partner
// pharmacy before go-live.
model Product {
  id                String           @id @default(cuid())
  slug              String           @unique
  name              String
  brandName         String?          @map("brand_name")
  kind              ConsultationKind
  category          ProductCategory
  form              ProductForm
  requiresColdChain Boolean          @default(false) @map("requires_cold_chain")
  // Minimum weeks on a titration step before stepping up.
  weeksPerStep      Int?             @map("weeks_per_step")
  // Days between doses, e.g. 7 for a weekly GLP-1 injection, 1 for a daily
  // gel/capsule. Null when the product has no clean fixed interval (e.g.
  // twice-weekly patches) — see dosesPerWeek for those.
  doseIntervalDays  Int?             @map("dose_interval_days")
  // For products taken a set number of times a week on fixed weekdays
  // rather than every N days, e.g. 2 for a twice-weekly patch (changed on
  // the same two days each week). Only used when doseIntervalDays is null.
  dosesPerWeek      Int?             @map("doses_per_week")
  defaultDirections String?          @map("default_directions")
  active            Boolean          @default(true)
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  strengths         ProductStrength[]
  prescriptionItems PrescriptionItem[]

  @@map("products")
}

enum DoseStatus {
  SCHEDULED
  TAKEN
  MISSED
  SKIPPED
}

// One scheduled occurrence of a medicine within a prescription item, e.g. a
// single weekly GLP-1 injection. Generated ahead of time on a rolling window
// (see DosingService) so the patient always has upcoming dates to see.
model DoseEvent {
  id                 String     @id @default(cuid())
  prescriptionItemId String     @map("prescription_item_id")
  patientId          String     @map("patient_id")
  scheduledFor       DateTime   @map("scheduled_for")
  status             DoseStatus @default(SCHEDULED)
  takenAt            DateTime?  @map("taken_at")
  note               String?
  // Set once a reminder email has gone out, so the cron doesn't resend one
  // every time it runs while the dose is still upcoming.
  reminderSentAt     DateTime?  @map("reminder_sent_at")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  prescriptionItem PrescriptionItem @relation(fields: [prescriptionItemId], references: [id], onDelete: Cascade)
  patient          Patient          @relation(fields: [patientId], references: [id])

  @@unique([prescriptionItemId, scheduledFor])
  @@index([patientId, scheduledFor])
  @@map("dose_events")
}

// A single analyte result (e.g. one estradiol or PSA draw), entered by staff
// today (no lab-partner integration yet). Kind-agnostic across HRT and GLP-1
// like CheckIn, so titration/dosing decisions can be checked against levels.
model LabResult {
  id                 String        @id @default(cuid())
  patientId          String        @map("patient_id")
  kind               LabResultKind
  // Required when kind is OTHER, since that kind alone doesn't say what was measured.
  analyteName        String?       @map("analyte_name")
  value              Float
  unit               String
  referenceRangeLow  Float?        @map("reference_range_low")
  referenceRangeHigh Float?        @map("reference_range_high")
  // Set at entry from the reference range, if one was given — lets the
  // review queue surface out-of-range results without recomputing per query.
  flagged            Boolean       @default(false)
  collectedAt        DateTime      @map("collected_at")
  note               String?
  enteredById        String?       @map("entered_by_id")
  reviewedAt         DateTime?     @map("reviewed_at")
  reviewedById       String?       @map("reviewed_by_id")
  reviewNote         String?       @map("review_note")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  patient    Patient    @relation(fields: [patientId], references: [id])
  enteredBy  Clinician? @relation("LabResultEnteredBy", fields: [enteredById], references: [id])
  reviewedBy Clinician? @relation("LabResultReviewedBy", fields: [reviewedById], references: [id])

  // History queries filter by patient and sort by collection date across all
  // kinds; the flagged-queue query filters flagged+unreviewed and sorts by
  // collection date.
  @@index([patientId, collectedAt])
  @@index([flagged, reviewedAt, collectedAt])
  @@map("lab_results")
}

model ProductStrength {
  id              String  @id @default(cuid())
  productId       String  @map("product_id")
  label           String
  packDescription String? @map("pack_description")
  // 1 = starting dose. Null for products that aren't titrated.
  titrationStep   Int?    @map("titration_step")
  defaultQuantity Int     @default(1) @map("default_quantity")
  sortOrder       Int     @default(0) @map("sort_order")
  active          Boolean @default(true)

  product           Product            @relation(fields: [productId], references: [id])
  prescriptionItems PrescriptionItem[]

  @@unique([productId, label])
  @@map("product_strengths")
}

model Message {
  id             String   @id @default(cuid())
  consultationId String   @map("consultation_id")
  senderId       String   @map("sender_id")
  senderRole     Role     @map("sender_role")
  content        String
  sentAt         DateTime @default(now()) @map("sent_at")

  consultation Consultation @relation(fields: [consultationId], references: [id])

  @@map("messages")
}

// Append-only — enforce INSERT/SELECT only grants at DB level, not just here
model AuditLogEntry {
  id           String   @id @default(cuid())
  actorId      String   @map("actor_id")
  actorRole    Role     @map("actor_role")
  action       String
  resourceType String   @map("resource_type")
  resourceId   String   @map("resource_id")
  metadata     Json?
  timestamp    DateTime @default(now())

  @@map("audit_log_entries")
}

model UploadedFile {
  id         String     @id @default(cuid())
  patientId  String     @map("patient_id")
  kind       UploadKind
  filename   String
  mimeType   String     @map("mime_type")
  storageKey String     @map("storage_key")
  createdAt  DateTime   @default(now()) @map("created_at")

  patient Patient @relation(fields: [patientId], references: [id])

  @@map("uploaded_files")
}

model CheckIn {
  id                   String            @id @default(cuid())
  patientId            String            @map("patient_id")
  dueAt                DateTime          @map("due_at")
  status               CheckInStatus     @default(SCHEDULED)
  token                String?           @unique
  tokenExpiresAt       DateTime?         @map("token_expires_at")
  sentAt               DateTime?         @map("sent_at")
  answers              Json?
  wantsToReorder       Boolean?          @map("wants_to_reorder")
  // Weight Journey: the weight and mood reported on submission, typed so the
  // journey can chart them. The full answer set stays in `answers`.
  weightKg             Decimal?          @map("weight_kg") @db.Decimal(4, 1)
  feeling              CheckInFeeling?
  // Captured on submission: the programme, questionnaire wording, the flags the
  // answers raised, and the prescription the patient was on at the time.
  kind                 ConsultationKind? @map("kind")
  questionnaireVersion String?           @map("questionnaire_version")
  redFlags             Json              @default("[]") @map("red_flags")
  prescriptionId       String?           @map("prescription_id")
  // The doctor's review of the completed check-in.
  reviewedAt           DateTime?         @map("reviewed_at")
  reviewedById         String?           @map("reviewed_by_id")
  outcome              CheckInOutcome?
  reviewNote           String?           @map("review_note")
  // What happened to billing as a result (price change, pause, cancellation).
  billingNote          String?           @map("billing_note")
  resultOrderId        String?           @map("result_order_id")
  resultPrescriptionId String?           @map("result_prescription_id")
  completedAt          DateTime?         @map("completed_at")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  patient      Patient       @relation(fields: [patientId], references: [id])
  prescription Prescription? @relation("CheckInPrescription", fields: [prescriptionId], references: [id])
  reviewedBy   Clinician?    @relation(fields: [reviewedById], references: [id])

  // The Weight Journey reads a patient's completed check-ins by date.
  @@index([patientId, completedAt])
  @@map("check_ins")
}

// A patient's Weight Journey endpoints. The starting weight is snapshotted from
// the intake questionnaire when the goal is created, so re-answering intake
// later doesn't rewrite the baseline progress is measured against.
model WeightGoal {
  id               String   @id @default(cuid())
  patientId        String   @unique @map("patient_id")
  startingWeightKg Decimal  @map("starting_weight_kg") @db.Decimal(4, 1)
  targetWeightKg   Decimal  @map("target_weight_kg") @db.Decimal(4, 1)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  patient Patient @relation(fields: [patientId], references: [id])

  @@map("weight_goals")
}

// A weight the patient recorded at a moment of their choosing — separate from the
// monthly check-in (whose weight stays on `check_ins`). Append-only: an entry is never
// edited or deleted; a mistake is voided, and staff fix one by voiding it and adding a
// replacement that points back at it. A trigger enforces this for every client.
model WeightEntry {
  id              String            @id @default(cuid())
  patientId       String            @map("patient_id")
  weightKg        Decimal           @map("weight_kg") @db.Decimal(4, 1)
  // When the weighing happened (chosen by the patient, default now) vs. when it was saved.
  measuredAt      DateTime          @map("measured_at")
  recordedAt      DateTime          @default(now()) @map("recorded_at")
  source          WeightEntrySource @default(PATIENT)
  note            String?
  // Client-generated id so a double tap or retry can't record the same weighing twice.
  clientRequestId String?           @map("client_request_id")
  correctsId      String?           @unique @map("corrects_id")
  voidedAt        DateTime?         @map("voided_at")
  voidedById      String?           @map("voided_by_id")
  voidReason      String?           @map("void_reason")

  patient     Patient      @relation(fields: [patientId], references: [id])
  corrects    WeightEntry? @relation("WeightEntryCorrection", fields: [correctsId], references: [id], onDelete: Restrict)
  correctedBy WeightEntry? @relation("WeightEntryCorrection")

  @@unique([patientId, clientRequestId])
  @@index([patientId, measuredAt])
  @@map("weight_entries")
}

model OnboardingSubmission {
  id                      String                 @id @default(cuid())
  patientId               String                 @unique @map("patient_id")
  idDocumentFileId        String?                @map("id_document_file_id")
  selfieFileId            String?                @map("selfie_file_id")
  personaStatus           PersonaStatus          @default(NOT_STARTED) @map("persona_status")
  bodyPhotoFrontFileId    String?                @map("body_photo_front_file_id")
  bodyPhotoSideFileId     String?                @map("body_photo_side_file_id")
  photoReviewStatus       PhotoReviewStatus      @default(NOT_STARTED) @map("photo_review_status")
  priorMedicationUse      Boolean?               @map("prior_medication_use")
  prescriptionProofType   PrescriptionProofType? @map("prescription_proof_type")
  prescriptionProofFileId String?                @map("prescription_proof_file_id")
  status                  OnboardingStatus       @default(IN_PROGRESS) @map("status")
  submittedAt             DateTime?              @map("submitted_at")
  reviewedAt              DateTime?              @map("reviewed_at")
  reviewedByClinicianId   String?                @map("reviewed_by_clinician_id")
  stepFeedback            Json                   @default("[]") @map("step_feedback")
  createdAt               DateTime               @default(now()) @map("created_at")
  updatedAt               DateTime               @updatedAt @map("updated_at")

  patient             Patient    @relation(fields: [patientId], references: [id])
  reviewedByClinician Clinician? @relation(fields: [reviewedByClinicianId], references: [id])

  @@map("onboarding_submissions")
}

// One identity-check session in verify-service. Deliberately minimal: the session
// id, our status for it and when it was decided. Photos and anything read from the
// document stay in verify-service and are never stored here.
model IdentityVerification {
  id          String                     @id @default(cuid())
  patientId   String                     @map("patient_id")
  // verify-service's id for the session.
  sessionId   String                     @unique @map("session_id")
  status      IdentityVerificationStatus @default(PENDING)
  // Reviewer's reason when REJECTED. Internal: never shown to the patient.
  reason      String?                    @map("reason")
  decidedAt   DateTime?                  @map("decided_at")
  // occurredAt of the newest event applied, so late or replayed events can't move
  // a session backwards.
  lastEventAt DateTime?                  @map("last_event_at")
  expiresAt   DateTime                   @map("expires_at")
  createdAt   DateTime                   @default(now()) @map("created_at")
  updatedAt   DateTime                   @updatedAt @map("updated_at")

  patient Patient @relation(fields: [patientId], references: [id])

  @@index([patientId, createdAt])
  @@map("identity_verifications")
}

// Webhook event ids already processed (deliveries are at-least-once).
model VerifyWebhookEvent {
  eventId    String   @id @map("event_id")
  sessionId  String   @map("session_id")
  receivedAt DateTime @default(now()) @map("received_at")

  @@map("verify_webhook_events")
}

model ThrottleCounter {
  key       String   @id
  hits      Int
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  @@map("throttle_counters")
}

// A patient agreeing to a specific version of a consent text. Append-only
// (enforced by a trigger), like the audit log: withdrawing consent is a new
// record, not an edit.
model Consent {
  id         String      @id @default(cuid())
  patientId  String      @map("patient_id")
  type       ConsentType
  version    String
  acceptedAt DateTime    @default(now()) @map("accepted_at")
  ipAddress  String?     @map("ip_address")
  userAgent  String?     @map("user_agent")

  patient Patient @relation(fields: [patientId], references: [id])

  @@index([patientId, type])
  @@map("consents")
}

enum SymptomScale {
  MRS
  AMS
}

// One filled-in symptom questionnaire (see src/symptoms/symptom-scales.ts):
// the Menopause Rating Scale for HRT, the Aging Males' Symptoms scale for
// TRT. Charted over time so patient and clinician can see which symptoms
// treatment is actually helping.
model SymptomAssessment {
  id         String       @id @default(cuid())
  patientId  String       @map("patient_id")
  scale      SymptomScale
  // [{ itemId, score }] exactly as answered; domain scores are derived on read.
  answers    Json
  totalScore Int          @map("total_score")
  recordedAt DateTime     @default(now()) @map("recorded_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  patient Patient @relation(fields: [patientId], references: [id])

  @@index([patientId, recordedAt])
  @@map("symptom_assessments")
}

// One friend a patient (the "referrer") has invited via their referral link.
// Created PENDING when the friend's Lead is created with a valid code;
// becomes CONVERTED once the friend's first payment actually succeeds — that's
// the point rewards are handed out, so a lead that never pays never costs anything.
model Referral {
  id                String         @id @default(cuid())
  // Snapshot of the code used, so history reads correctly even if the
  // referrer's own code is ever regenerated.
  code              String
  referrerId        String         @map("referrer_id")
  referredLeadId    String         @unique @map("referred_lead_id")
  referredPatientId String?        @unique @map("referred_patient_id")
  status            ReferralStatus @default(PENDING)
  createdAt         DateTime       @default(now()) @map("created_at")
  convertedAt       DateTime?      @map("converted_at")

  referrer        Patient   @relation("ReferralsMade", fields: [referrerId], references: [id])
  referredLead    Lead      @relation(fields: [referredLeadId], references: [id])
  referredPatient Patient?  @relation("ReferralsReceived", fields: [referredPatientId], references: [id])
  vouchers        Voucher[]

  @@index([referrerId])
  @@map("referrals")
}

// A single $-off reward earned through the referral programme, for either
// side of a Referral. ISSUED until applied; how "applying" actually works is
// up to the service layer (today: a Stripe customer-balance credit, since
// every patient is on a subscription — see ReferralsService.applyVoucher).
model Voucher {
  id          String        @id @default(cuid())
  patientId   String        @map("patient_id")
  referralId  String        @map("referral_id")
  kind        VoucherKind
  amountCents Int           @map("amount_cents")
  currency    String        @default("gbp")
  status      VoucherStatus @default(ISSUED)
  issuedAt    DateTime      @default(now()) @map("issued_at")
  appliedAt   DateTime?     @map("applied_at")
  note        String?

  patient  Patient  @relation(fields: [patientId], references: [id])
  referral Referral @relation(fields: [referralId], references: [id])

  @@index([patientId])
  @@map("vouchers")
}
