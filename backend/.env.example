DATABASE_URL=postgresql://telehealth:telehealth_dev@localhost:5432/telehealth
JWT_SECRET=change-me-use-aws-secrets-manager-in-production
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
PORT=4000
# Local dev shown below. In production (EC2): ALLOWED_ORIGINS=https://webmaverics.com,https://app.webmaverics.com,https://clinician.webmaverics.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Stripe
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_secret_here

# Public URL of the website (the Next.js app in website/, or the live domain).
# Used for Stripe Checkout redirects in src/checkout/checkout.service.ts
# (/checkout/success, /checkout/cancel) and as the base of referral links.
WEBFLOW_SITE_URL=http://localhost:3001

# Email (Resend — https://resend.com, free tier is enough)
RESEND_API_KEY=re_your_key_here
EMAIL_FROM=noreply@yourdomain.com

# Patient app URL (for activation links in emails)
# Local dev shown below. In production: PATIENT_APP_URL=https://app.webmaverics.com
PATIENT_APP_URL=http://localhost:3000

# Prescribers must have MFA enabled before approving a consultation. Defaults to
# required; set to false only for local dev, where seeded clinicians have no MFA.
PRESCRIBER_MFA_REQUIRED=false

# Referral programme: a Stripe Coupon (amount off, duration "once") created by
# hand in the Stripe Dashboard. Attached automatically to a referred friend's
# first Checkout Session/Subscription — see src/checkout/checkout.service.ts.
STRIPE_REFERRAL_FRIEND_COUPON_ID=coupon_...

# Stripe price ids for each plan. Used to move a patient's subscription when a
# check-in changes their prescription (e.g. GLP-1 Starter → Advanced).
STRIPE_PRICE_GLP1_STARTER=price_...
STRIPE_PRICE_GLP1_ADVANCED=price_...
STRIPE_PRICE_HRT_STARTER=price_...
STRIPE_PRICE_HRT_COMPLETE=price_...
STRIPE_PRICE_TRT_STANDARD=price_...

# Printed on prescription PDFs.
CLINIC_NAME=Telehealth Clinic
CLINIC_ADDRESS=

# Encrypts ID documents and photos at rest (AES-256-GCM). 32 random bytes,
# base64: `openssl rand -base64 32`. Set it before the first real upload and
# never change it — files encrypted with a lost key can't be read.
UPLOAD_ENCRYPTION_KEY=
# Where uploads are stored; defaults to ./uploads.
# UPLOAD_DIR=

# Authenticates Vercel Cron Jobs calling /internal/cron/* (see vercel.json).
# Vercel automatically sends this as `Authorization: Bearer <value>` once set
# as a project env var: https://vercel.com/docs/cron-jobs/manage-cron-jobs
CRON_SECRET=

# External pharmacy partner. When a prescription is approved (and for every repeat),
# the order is passed to the partner as a structured JSON summary — by webhook,
# by email, or both. Leave all of these empty to send nothing: the Orders page
# still shows the payload so it can be copied by hand.
PARTNER_NAME=
# POST of the JSON; signed with PARTNER_WEBHOOK_SECRET as
# X-Telehealth-Signature: sha256=HMAC_SHA256(secret, "<X-Telehealth-Timestamp>.<body>")
# Both URL and SECRET are required: with only the URL the webhook stays switched off (nothing is sent unsigned).
# The same webhook also receives "order.cancelled" when an order the partner already has is withdrawn.
PARTNER_WEBHOOK_URL=
PARTNER_WEBHOOK_SECRET=
# Comma-separated; needs RESEND_API_KEY. The JSON is attached to the email.
PARTNER_ORDER_EMAIL=

# Next-shipment alerts: how long one supply lasts, and how many days before it
# runs out to start warning operations.
SHIPMENT_CYCLE_DAYS=30
SHIPMENT_LEAD_DAYS=5

# Sales funnel, first two stages (website visitors, people who started the quiz): read
# from PostHog's query API. Needs a *personal* API key with "Query: read" access
# (PostHog → Settings → Personal API keys) — not the project key the website uses —
# and the project's numeric id. Leave empty to start the funnel at the eligibility quiz.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=

# Where uploaded files (ID documents, body photos, progress photos) are stored. They are encrypted
# by the app (UPLOAD_ENCRYPTION_KEY above) before they are stored, so storage only ever holds ciphertext.
# With UPLOAD_S3_BUCKET set they go to Amazon S3 (private bucket, encrypted at rest by S3 as well);
# credentials come from the usual AWS settings: AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY, or a role.
# Leave it empty to use the server's disk (UPLOAD_DIR above) — fine for local development only, since
# a serverless host (Vercel) does not keep files. Existing files are not moved when you switch.
UPLOAD_S3_BUCKET=
UPLOAD_S3_REGION=
# Optional: encrypt objects with this AWS KMS key (SSE-KMS) instead of S3-managed keys.
UPLOAD_S3_KMS_KEY_ID=
