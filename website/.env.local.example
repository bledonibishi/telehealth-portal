# Stripe — this app only calls the Stripe API server-side (Checkout Session creation),
# so only the secret key is needed here.
STRIPE_SECRET_KEY=sk_test_...

# The Webflow site's domain — used for CORS (Webflow calls /api/checkout cross-origin)
# and as the Stripe success_url/cancel_url target (those pages now live in Webflow).
WEBFLOW_SITE_URL=https://webmaverics.com

# Stripe Price IDs — these are NOT read from env at runtime (public/scripts/checkout.js
# is a static file served as-is, it can't read process.env). Create the prices in your
# Stripe Dashboard > Products, then paste the price IDs into the PLANS object in
# public/scripts/checkout.js directly. Listed here just for reference:
# STRIPE_PRICE_HRT_STARTER=price_...
# STRIPE_PRICE_HRT_COMPLETE=price_...
# STRIPE_PRICE_GLP1_STARTER=price_...
# STRIPE_PRICE_GLP1_ADVANCED=price_...
