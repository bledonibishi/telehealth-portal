# Payments run through the NestJS backend (it holds STRIPE_SECRET_KEY and the
# referral coupon logic), so this app needs no server-side Stripe secret.
# Set the backend's WEBFLOW_SITE_URL to this app's URL (http://localhost:3001 locally)
# so Stripe redirects back to /checkout/success.

# ── Client-side (quiz → checkout flow) ──────────────────────────────────────
# The NestJS backend URL (GraphQL createLead, /api/checkout, success-info)
NEXT_PUBLIC_API_BASE=http://localhost:4000

# The patient portal (the `web` app) — where new patients set their password.
NEXT_PUBLIC_PORTAL_URL=http://localhost:3000

# Mobile app store links shown on the success page. Leave empty to hide the badges.
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=

# Stripe publishable key — if set, the inline Stripe element is shown.
# Leave empty to fall back to Stripe-hosted Checkout (redirect flow).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe Price IDs — create in Stripe Dashboard > Products, then paste IDs here.
NEXT_PUBLIC_STRIPE_PRICE_HRT_STARTER=price_...
NEXT_PUBLIC_STRIPE_PRICE_HRT_COMPLETE=price_...
NEXT_PUBLIC_STRIPE_PRICE_GLP1_STARTER=price_...
NEXT_PUBLIC_STRIPE_PRICE_GLP1_ADVANCED=price_...
NEXT_PUBLIC_STRIPE_PRICE_TRT_STANDARD=price_...
# Display price for the TRT plan (must match the Stripe price above).
NEXT_PUBLIC_PRICE_TRT_STANDARD=£...

# PostHog project key (public) — the website sends page views and `quiz_started`, which the
# admin's sales funnel reads. Leave empty to turn analytics off.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
