# ── Server-side (Stripe checkout session creation) ──────────────────────────
STRIPE_SECRET_KEY=sk_test_...

# The public URL of this Next.js app — used in Stripe success/cancel redirect URLs
# and as the CORS origin for the /api/checkout route.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# ── Client-side (quiz → checkout flow) ──────────────────────────────────────
# The NestJS backend URL (used for GraphQL createLead mutation)
NEXT_PUBLIC_API_BASE=http://localhost:3000

# Stripe publishable key — if set, the inline Stripe element is shown.
# Leave empty to fall back to Stripe-hosted Checkout (redirect flow).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe Price IDs — create in Stripe Dashboard > Products, then paste IDs here.
NEXT_PUBLIC_STRIPE_PRICE_HRT_STARTER=price_...
NEXT_PUBLIC_STRIPE_PRICE_HRT_COMPLETE=price_...
NEXT_PUBLIC_STRIPE_PRICE_GLP1_STARTER=price_...
NEXT_PUBLIC_STRIPE_PRICE_GLP1_ADVANCED=price_...
