{
  "expo": {
    "name": "Telehealth",
    "slug": "omopharmacy",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.telehealth.patient"
    },
    "android": {
      "package": "com.telehealth.patient",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      "expo-notifications",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Used to upload your ID, body, and prescription photos for clinical verification.",
          "cameraPermission": "Used to take your ID, body, and prescription photos for clinical verification."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Used to take your full body photos for clinical verification."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "6d070af0-1b39-48b2-a592-f63d291fbe1d"
      }
    },
    "owner": "bledonibishi-omos-team"
  }
}
