DATABASE_URL=postgresql://telehealth:telehealth_dev@localhost:5432/telehealth

# Backend: reads uploaded prescription proof with Claude. Leave empty to skip the
# automatic check (proof then goes to manual clinician review only).
ANTHROPIC_API_KEY=
# Optional: which Claude model reads prescription proof (default claude-sonnet-5-5).
# Compare first with: pnpm --filter @telehealth/backend compare-proof-models <folder>
PROOF_READER_MODEL=

# Backend: traces the Claude calls above (model, tokens, cost, timings) in Langfuse. Leave the keys empty to turn it off.
# Only instructions, token counts and a summary of each answer are sent: never the photos or documents, and never a
# patient's name, medicine, dose or dates. Still health-related, so use the EU region (or self-host) and have a data
# processing agreement with Langfuse before turning it on for real patients.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Optional: how traces are grouped in Langfuse (default: NODE_ENV). LANGFUSE_TRACING_ENABLED=false switches tracing off.
LANGFUSE_TRACING_ENVIRONMENT=

# Backend (local development only, ignored in production): skip the emailed code the website quiz asks for. Needed
# only by the dev /test-checkout page, which has no inbox. Without it the quiz works as in production: with no
# RESEND_API_KEY the six-digit code is printed in the backend log instead of emailed.
# DISABLE_EMAIL_VERIFICATION=true

# Backend, local development only (ignored in production): no limit on how many sign-up codes one address can ask for, so
# testing the quiz over and over doesn't hit "Too many codes were sent". DISABLE_EMAIL_VERIFICATION=true skips the code entirely.
# RELAX_EMAIL_CODE_LIMITS=true

# Backend: the doctor's prescription fee in cents, shown as its own line at checkout and kept when a refund is made after a
# prescription has been written. Default 4000 (€40); 0 switches the fee off. Euro prices only.
# PRESCRIPTION_FEE_CENTS=4000

# Backend: the fee in cents for an extra live video or in-person consultation a patient chooses to book (euro). Unset or 0
# means free. Never charged for side effects, pain, urgent requests or warning signs; the monthly check-in and messages stay free.
# CONSULT_FEE_CENTS=

# Patient web app: Stripe's publishable key (pk_test_… / pk_live_…), so an extra consultation is paid inside the portal. Without it
# the patient is sent to Stripe's invoice page instead.
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Backend: public https address of the logo shown at the top of emails, e.g. https://app.omopharmacy.com/omo-logo.png
# (the file is web/public/omo-logo.png). Without it emails show a letter tile instead.
EMAIL_LOGO_URL=

# Backend: monthly Stripe price ids for the plans (Recurring · Monthly · EUR).
# Each GLP-1 dose has its own price, linked with `pnpm sync-dose-prices` (not set here).
# HRT — Oestrogen only (€39)
STRIPE_PRICE_OESTROGEN=
# HRT — Oestrogen + progesterone (€59)
STRIPE_PRICE_OESTROGEN_PROGESTERONE=
# TRT — Testosterone gel (€79)
STRIPE_PRICE_TRT_STANDARD=

# Patient portal (web): shown on My Doctor and the dashboard. A line is only shown when it is set,
# so the portal never displays a made-up number or hours.
# NEXT_PUBLIC_SUPPORT_HOURS=Monday to Friday, 09:00–17:00
# NEXT_PUBLIC_SUPPORT_PHONE=
# NEXT_PUBLIC_SUPPORT_EMAIL=
# Patient portal (web): the how-to-inject video on the Injections page. A YouTube link (watch, youtu.be or embed).
# Until it is set, the video button says the video is coming soon.
# NEXT_PUBLIC_INJECTION_VIDEO_URL=https://www.youtube.com/watch?v=...

# Patient mobile app (mobile/): optional. A line is only shown in the app when it is set.
# EXPO_PUBLIC_PORTAL_URL=https://app.example.com
# EXPO_PUBLIC_SUPPORT_HOURS=Monday to Friday, 09:00–17:00
# EXPO_PUBLIC_INJECTION_VIDEO_URL=https://www.youtube.com/watch?v=...

# Backend: identity verification through verify-service (a separate service, see its
# docs/pharmacy-integration.md). Leave all three empty to keep the in-app ID upload with
# manual clinician review.
# VERIFY_BASE_URL: where the service runs, e.g. http://localhost:4100 locally, https://... in production.
# VERIFY_API_KEY: the tenant API key (vk_...). Server secret: never put it in a browser or mobile app.
# VERIFY_WEBHOOK_SECRET: the tenant webhook secret (whsec_...), used to check result webhooks.
# In verify-service, point the tenant's webhook at this backend:
#   pnpm tenant:update <tenantId> --webhook-url=<this backend's public URL>/verify/webhook
VERIFY_BASE_URL=
VERIFY_API_KEY=
VERIFY_WEBHOOK_SECRET=

# Backend: the address of the clinician app. Team invitation links point here (/accept-invite?token=...),
# so set it to the real address in production. Defaults to http://localhost:3002.
# CLINICIAN_APP_URL=http://localhost:3002
